-- Migration v1 -> v2 (README v2 §21): add the engineering reference library table
-- with license metadata per §18/§38. Data-preserving: no existing table is altered.
CREATE TABLE engineering_references (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  title TEXT NOT NULL,
  category TEXT NOT NULL,
  source TEXT NOT NULL,
  edition TEXT NOT NULL,
  license_type TEXT NOT NULL,
  license_notes TEXT NOT NULL,
  date_added INTEGER NOT NULL,
  verified_by TEXT NOT NULL
);
