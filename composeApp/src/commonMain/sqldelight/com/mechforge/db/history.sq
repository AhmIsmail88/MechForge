CREATE TABLE calculation_history (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  calculator_id TEXT NOT NULL,
  title TEXT NOT NULL,
  timestamp INTEGER NOT NULL,
  inputs_json TEXT NOT NULL,
  results_json TEXT NOT NULL,
  -- the project this calculation belongs to, and a frozen copy of its data: revising the
  -- project later must not rewrite an issued calculation (engineering audit section 5.1)
  project_id INTEGER REFERENCES projects(id) ON DELETE SET NULL,
  project_snapshot TEXT,
  calculation_number TEXT,
  revision TEXT,
  status TEXT
);

insertHistory:
INSERT INTO calculation_history(calculator_id, title, timestamp, inputs_json, results_json)
VALUES (?, ?, ?, ?, ?);

insertHistoryFull:
INSERT INTO calculation_history(calculator_id, title, timestamp, inputs_json, results_json,
                                project_id, project_snapshot, calculation_number, revision, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

countHistoryByProject:
SELECT COUNT(*) FROM calculation_history WHERE project_id = ?;

selectAllHistory:
SELECT * FROM calculation_history ORDER BY timestamp DESC;

getHistoryById:
SELECT * FROM calculation_history WHERE id = ?;

updateHistoryTitle:
UPDATE calculation_history SET title = ? WHERE id = ?;

deleteHistory:
DELETE FROM calculation_history WHERE id = ?;

duplicateHistory:
INSERT INTO calculation_history(calculator_id, title, timestamp, inputs_json, results_json)
SELECT calculator_id, title || ' (copy)', ?, inputs_json, results_json FROM calculation_history WHERE id = ?;

recentCalculators:
SELECT calculator_id, MAX(timestamp) AS last_used FROM calculation_history
GROUP BY calculator_id ORDER BY last_used DESC LIMIT ?;
